# Environment Configuration for LifeOS
# Copy this file to .env and update with your actual values

# ===== FLASK CONFIGURATION =====
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=your-secret-key-here-change-in-production-use-strong-random-string

# ===== DATABASE CONFIGURATION =====
# Using SQLite for easy development (no MySQL setup needed)
# To use MySQL instead: DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lifeos_dev
DATABASE_URL=sqlite:///lifeos_dev.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=lifeos_dev

# For Docker setup, use:
# DATABASE_URL=mysql+pymysql://lifeos_user:lifeos_password@mysql:3306/lifeos_dev

# ===== GOOGLE GEMINI API =====
GEMINI_API_KEY=AIzaSyBxNX7DbiI8OOU8mzw6H0B5QV30bsA7TdA
# Get your API key from: https://makersuite.google.com/app/apikey

# ===== APPLICATION SETTINGS =====
DEBUG=True
TESTING=False

# ===== EMAIL CONFIGURATION (Optional) =====
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=lifeos.log

# ===== SECURITY =====
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

